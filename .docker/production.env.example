# Copy to .docker/production.env on the server and restrict permissions to the deploy user.

POSTGRES_DB=ncjm
POSTGRES_USER=ncjm
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=ncjm.settings
DJANGO_ALLOWED_HOSTS=nikoscornyjokemachine.com
DJANGO_CORS_ORIGIN_WHITELIST=https://nikoscornyjokemachine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nikoscornyjokemachine.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600

NCJM_API_ENABLED=False
NCJM_ALLOWED_REACTIONS=

RECAPTCHA_PUBLIC_KEY=replace-me
RECAPTCHA_PRIVATE_KEY=replace-me

GA_ENABLED=False
GA_MEASUREMENT_ID=
